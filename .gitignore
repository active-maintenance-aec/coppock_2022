# The book itself is not redistributed here; the README links to the publisher's DOI.
coppock_2022.pdf

# The deposited archive is fetched from Dataverse by download_original.R rather than
# redistributed. original_extracted/ is the tree that script unpacks it into, rebuilt on
# every run, and nothing else may write there.
original/
original_extracted/

# Working log stays private, per the house rule for public repos.
notes.md

# Measured durations are a property of the machine on the day, not of the pipeline.
run_timings.csv

# Quarto build artifacts
/.quarto/
*_files/
**/*.quarto_ipynb

# Quarto copies referenced resources beside the PDF; the PDF already embeds them.
report/maintained/

# RStudio project state
.Rproj.user/
.Rhistory
.DS_Store
